
# ================================================================
# Perimetr MVP — example configuration
# Copy this file to .env and adjust it before running the pilot.
# ================================================================

# Main detector
YOLO_MODEL=models/perimetr_scene_v3_best.pt
YOLO_CONFIDENCE=0.35
YOLO_DEVICE=auto
YOLO_IMG_SIZE=512
YOLO_ADAPTIVE_SIZE_ENABLED=true
YOLO_FALL_RECOVERY_IMG_SIZE=640
YOLO_FALL_RECOVERY_SCAN_INTERVAL_FRAMES=3
YOLO_FALL_RECOVERY_HOLD_FRAMES=12
YOLO_FALL_RECOVERY_HORIZONTAL_RATIO=1.20
YOLO_PRECISION=auto
YOLO_BACKEND=auto
# Optional optimized exports. Missing runtimes/files safely fall back to PyTorch.
YOLO_ONNX_MODEL=
YOLO_TENSORRT_MODEL=
YOLO_ALLOW_BACKEND_FALLBACK=true
YOLO_FAST_PREDICTOR_ENABLED=true
YOLO_WARMUP_RUNS=3
# scene-v3: 0=person, 1=car, 2=bus, 3=truck, 4=excavator,
# 5=bulldozer, 6=grader, 7=loader, 8=mobile_crane, 9=road_roller
YOLO_PERSON_CLASS_IDS=0
YOLO_HAZARD_CLASS_IDS=1,2,3,4,5,6,7,8,9

# Rolling per-stage diagnostics (DEBUG + /api/diagnostics/performance)
PERFORMANCE_PROFILING_ENABLED=true
PERFORMANCE_WINDOW_FRAMES=600
PERFORMANCE_DEBUG_INTERVAL_SEC=10

# PPE checkpoint
PPE_MODEL=ppe.pt
PPE_CONFIDENCE=0.35
PPE_MIN_PERSON_HEIGHT_FRAC=0.30
PPE_COOLDOWN_SEC=4

# Person-machine dynamic safety zones
DANGER_WARNING_DISTANCE_M=3.0
DANGER_DANGER_DISTANCE_M=1.5
DANGER_PROXIMITY_PX=80
DANGER_DANGER_PROXIMITY_PX=28
DANGER_CONSECUTIVE_FRAMES=3
DANGER_COOLDOWN_SEC=10

# Posture / coordination / observable behaviour analysis
POSTURE_ENABLED=true
POSTURE_MODEL=models/pose_landmarker_heavy.task
POSTURE_SAMPLE_FPS=15
POSTURE_MAX_POSES=4
POSTURE_MIN_PERSON_HEIGHT_FRAC=0.18
POSTURE_MIN_PERSON_LONG_SIDE_FRAC=0.10
POSTURE_MIN_PERSON_AREA_FRAC=0.0025
POSTURE_CROP_MARGIN=0.24
POSTURE_CROP_CENTER_FOLLOW=0.72
POSTURE_CROP_SIZE_FOLLOW=0.28
POSTURE_OPTICAL_FLOW_ENABLED=true
POSTURE_OPTICAL_FLOW_SCALE=0.5
POSTURE_OPTICAL_FLOW_WIN_SIZE=21
POSTURE_OPTICAL_FLOW_MAX_LEVEL=3
POSTURE_OPTICAL_FLOW_FB_THRESHOLD_PX=1.5
POSTURE_OPTICAL_FLOW_MAX_JUMP_FRAC=0.18
POSTURE_BEHAVIOR_ENABLED=true
POSTURE_BEHAVIOR_MODEL=models/behavior/tcn_gru_pose_event_v2/model.pt
POSTURE_BEHAVIOR_DEVICE=auto
POSTURE_BEHAVIOR_FEATURE_FPS=15
POSTURE_BEHAVIOR_MIN_VALID_RATIO=0.45
POSTURE_BEHAVIOR_MIN_WINDOW_COVERAGE=0.70
POSTURE_BEHAVIOR_MAX_SAMPLE_GAP_SEC=0.50
POSTURE_BEHAVIOR_INFERENCE_STRIDE=3
POSTURE_BEHAVIOR_SMOOTHING_WINDOWS=4
POSTURE_BEHAVIOR_ALERTS_ENABLED=true
POSTURE_LEARNED_EVENTS_ENABLED=true
POSTURE_HEURISTIC_ALERTS_ENABLED=false
POSTURE_UNSTABLE_THRESHOLD=0.82
POSTURE_UNSTABLE_CONFIRM_SEC=2.4
POSTURE_FALL_THRESHOLD=0.68
POSTURE_GROUND_THRESHOLD=0.72
POSTURE_DIRECT_FALL_THRESHOLD=0.88
POSTURE_DIRECT_FALL_ACTION_THRESHOLD=0.72
POSTURE_DIRECT_FALL_CONFIRM_SEC=0.8
POSTURE_FALL_FOLLOWUP_SEC=4.0
POSTURE_GROUND_CONFIRM_SEC=0.8
POSTURE_MIN_TORSO_QUALITY_FOR_FALL=0.45
POSTURE_MIN_LOWER_BODY_QUALITY_FOR_UNSTABLE=0.45
POSTURE_WARNING_SCORE=0.50
POSTURE_DANGER_SCORE=0.82
POSTURE_CONSECUTIVE_WINDOWS=2
POSTURE_COOLDOWN_SEC=15
POSTURE_HAND_TO_MOUTH_ENABLED=true
POSTURE_HAND_TO_MOUTH_RATIO=0.65
POSTURE_HAND_TO_MOUTH_FRACTION=0.55

# Visible QR worker tag; no face recognition
WORKER_ID_ENABLED=true
WORKER_ID_SAMPLE_FPS=1.5
WORKER_ID_CACHE_TTL_SEC=4
WORKER_ID_CROP_PADDING=0.15
WORKER_ID_PROFILE_CACHE_TTL_SEC=60
WORKER_ID_FULL_FRAME_FALLBACK=false
WORKER_ID_MAX_PENDING_FRAMES=1
WORKER_ID_DIAGNOSTIC_LOGGING=false
WORKER_ID_CONFIRM_SCANS=2
WORKER_ID_SWITCH_CONFIRM_SCANS=4
WORKER_ID_DISPLAY_TTL_SEC=5.0
WORKER_ID_ALERT_MAX_AGE_SEC=2.0
WORKER_ID_AMBIGUOUS_IOU_THRESHOLD=0.35
WORKER_ID_ENFORCE_UNIQUE_ACTIVE_ID=true
WORKER_ID_REACQUIRE_ENABLED=true
WORKER_ID_REACQUIRE_MAX_GAP_SEC=0.7
WORKER_ID_SHOW_DEBUG_STATUS=false
WORKER_ID_REQUIRE_AT_CHECKPOINT=true
WORKER_ID_REQUIRE_ON_SITE=false
WORKER_ID_UNIDENTIFIED_FRAMES=3
WORKER_ID_UNIDENTIFIED_COOLDOWN_SEC=20

# Backend-decoded demonstration videos
DEMO_VIDEO_UPLOAD_DIR=data/tmp/demo_uploads
DEMO_VIDEO_OUTPUT_DIR=data/tmp/demo_outputs
DEMO_VIDEO_MAX_SIZE_MB=2048
DEMO_VIDEO_ALLOWED_EXTENSIONS=.mp4,.avi,.mov,.mkv
DEMO_VIDEO_JOB_TTL_SEC=3600
DEMO_VIDEO_MAX_PENDING_JOBS=2
DEMO_VIDEO_PROCESSING_ENABLED=true
DEMO_VIDEO_PLAYBACK_MODE=realtime
DEMO_VIDEO_PROBE_TIMEOUT_SEC=15
DEMO_VIDEO_CONTROL_TIMEOUT_SEC=10
WORKER_DATABASE_PATH=data/workers.sqlite3

# Evidence clips around confirmed incidents
EVIDENCE_ENABLED=true
EVIDENCE_CLIPS_DIR=data/event_clips
EVIDENCE_PRE_SECONDS=3
EVIDENCE_POST_SECONDS=3
EVIDENCE_SAMPLE_FPS=3
EVIDENCE_FFMPEG_BINARY=

# Server and optional demo access protection
SERVER_PORT=8000
PANEL_PASSWORD=
DEMO_TOKEN=

# Optional monocular 3D preview (single RGB camera)
# Requires: python -m pip install -r requirements-depth3d.txt
DEPTH3D_ENABLED=true
# Indoor is active for the current room tests.
DEPTH3D_MODEL_ID=depth-anything/Depth-Anything-V2-Metric-Indoor-Small-hf
# Outdoor/build-site alternative:
# DEPTH3D_MODEL_ID=depth-anything/Depth-Anything-V2-Metric-Outdoor-Small-hf
DEPTH3D_DEVICE=0
DEPTH3D_LOCAL_FILES_ONLY=false
DEPTH3D_MIN_DEPTH_M=0.20
DEPTH3D_MAX_DEPTH_M=20
DEPTH3D_VIS_MAX_DEPTH_M=10
DEPTH3D_POINT_STRIDE=5
DEPTH3D_TARGET_FPS=8
DEPTH3D_PERSON_DISTANCE_ENABLED=true
DEPTH3D_CALIBRATION_PATH=data/depth3d_calibration.json
DEPTH3D_CALIBRATION_PROFILES_DIR=data/depth3d_calibrations
