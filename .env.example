# YOLO configuration
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_DEVICE=cpu              # cpu or cuda:0
YOLO_IMG_SIZE=640

# Danger detection
DANGER_PROXIMITY_PX=50       # pixels — "too close" threshold
DANGER_CONSECUTIVE_FRAMES=3  # frames before confirming alarm
DANGER_COOLDOWN_SEC=10       # seconds between repeat alarms

# Server
SERVER_PORT=8000
